[user]
	name = "Anindya Shiddhartha"
	email = shiddhartha@tuta.io
	signingkey = /Users/hitblast/.ssh/id_ed25519_code.pub

[core]
    pager = delta
    compression = 9
    whitespace = error
    preloadindex = true
	excludesfile = /Users/hitblast/.gitignore-global

[advice]
    addEmptyPathspec = false
    pushNonFastForward = false
    statusHints = false

[url "git@codeberg.org:"]
    insteadOf = "berg:"

[url "git@github.com:"]
    insteadOf = "hub:"

[diff]
    algorithm = histogram

[rerere]
    enabled = true

[gpg]
	format = "ssh"

[gpg.ssh]
    allowedSignersFile = "~/.config/git/allowed-signers"

[init]
    defaultBranch = master

[status]
    branch = true
    showStash = true
    showUntrackedFiles = all

[push]
    autoSetupRemote = true
    default = current
    followTags = true

[tag]
    gpgSign = true

[commit]
	gpgsign = true

[fetch]
	prune = true

[pull]
    default = current
	rebase = true

[rebase]
	autostash = true
    missingCommitsCheck = warn

[log]
    abbrevCommit = true

[branch "master"]
	rebase = true
[branch "main"]
	rebase = true

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
    side-by-side = true

[merge]
	conflictstyle = zdiff3
